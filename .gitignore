# Keep only the minimal native Windows QEMU runtime in Git. Its source tree,
# MSYS2 installation and build outputs remain ignored under the same folder.
!/local_tools/qemu-sdspi-windows/
/local_tools/qemu-sdspi-windows/*
!/local_tools/qemu-sdspi-windows/README.md
!/local_tools/qemu-sdspi-windows/LICENSE
!/local_tools/qemu-sdspi-windows/COPYING
!/local_tools/qemu-sdspi-windows/COPYING.LIB
!/local_tools/qemu-sdspi-windows/bin/
/local_tools/qemu-sdspi-windows/bin/*
!/local_tools/qemu-sdspi-windows/bin/qemu-system-xtensa.exe
!/local_tools/qemu-sdspi-windows/share/
/local_tools/qemu-sdspi-windows/share/*
!/local_tools/qemu-sdspi-windows/share/qemu/
/local_tools/qemu-sdspi-windows/share/qemu/*
!/local_tools/qemu-sdspi-windows/share/qemu/esp32-v3-rom.bin
!/local_tools/qemu-sdspi-windows/share/qemu/esp32-v3-rom-app.bin
